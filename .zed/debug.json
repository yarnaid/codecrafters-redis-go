[
  {
    "label": "Debug current file",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "$ZED_FILE"
  },
  {
      "label": "Debug server",
      "adapter": "Delve",
      "request": "launch",
      "mode": "debug",
      "program": "$ZED_WORKTREE_ROOT/app",
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
      "label": "Debug tests in current package",
      "adapter": "Delve",
      "request": "launch",
      "mode": "test",
      "program": "$ZED_DIRNAME",
      "cwd": "$ZED_WORKTREE_ROOT"
    }
]
